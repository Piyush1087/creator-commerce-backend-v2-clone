{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.prompt.md",
        "watchAssets": true
      },
      {
        "include": "features/brand-centre/prompts/contracts/**/*.md",
        "watchAssets": true
      }
    ]
  }
}
