  pipelineHealth   UcePipelineHealthStatus @default(ON_TRACK) @map("pipeline_health")

  negotiationState UceNegotiationSubState? @map("negotiation_state")
  securementState  UceSecurementSubState?  @map("securement_state")
  logisticsState   UceLogisticsSubState?   @map("logistics_state")
