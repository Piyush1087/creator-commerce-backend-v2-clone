generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  BRAND
  CREATOR
  ADMIN
}

enum DiscoveryLeadStatus {
  PENDING
  VALIDATING
  IDENTIFIED
  REJECTED
}

enum IndustryVertical {
  D2C
  SAAS_AI
  HEALTHCARE
  OFFLINE_SERVICES
  REAL_ESTATE
  B2B_AGENCY
  MEDIA
  EDUCATION
  ENTERTAINMENT
  UNKNOWN
  GAMBLING
  ADULT
  FRAUDULENT_HIGH_RISK
}

enum MarketIntelRejectionType {
  UNSUPPORTED_NICHE
  GARBAGE_ENTRY
  BLOCKED_PLATFORM
  SECURITY_RISK
}

enum ScanStatus {
  PENDING
  SURFACE_COMPLETE
  VERIFIED
  DEEP_SCAN_IN_PROGRESS
  READY
}

enum OfferingType {
  PRODUCT
  MODULE
  TREATMENT
  EXPERIENCE
  SERVICE
  COLLECTION
}

enum PerformanceColor {
  GREEN
  YELLOW
  RED
}

enum LeakBucket {
  PDP
  PAID
  ROSTER
  CREATIVE_HOOK
}

enum PriorityRank {
  HIGH
  MEDIUM
  LOW
  NEGLIGIBLE
}

enum LeakPlannerStatus {
  PENDING_USER_REVIEW
  PUSHED_TO_PLANNER
  DISCARDED
  EXECUTED
}

enum PlannerCardType {
  NEW_CAMPAIGN
  SUGGESTED_UPDATE
  AUTO_PAUSE_LOG
}

enum CampaignObjective {
  PULSE
  PROOF
  PUSH
  PRODUCTION
}

enum CreatorTier {
  NANO
  MICRO
  MID_TIER
  MEGA
  CELEBRITY
}

enum PlannerWorkflowStatus {
  PENDING_USER_REVIEW
  PROCEEDED_TO_PIPELINE
  DISCARDED
  AUTO_EXECUTED_BYPASS
}

enum IntelStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PlanType {
  FREE_TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Vendor surface-scan runs only (cache hits are not counted toward rate limits).
enum SurfaceScanAttemptKind {
  SURFACE_VENDOR
}

enum BrandRoutingType {
  D2C_SKINCARE
  SAAS_PRODUCT
  HEALTHCARE_TREATMENT
  OFFLINE_EXPERIENCE
}

enum BudgetAllocationPhase {
  PHASE_1_COLD_START
  PHASE_2_SELF_HEALING
}

enum BrandCentreJobType {
  DEEP_SCAN
  INTELLIGENCE_REFRESH
  PLANNER_AGGREGATE
}

enum BrandCentreJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================================
// UCE (Universal Campaign Engine) ENUMS
// ============================================================================

enum UceCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum UceTimelineStructure {
  FIXED_DATES
  DYNAMIC_MILESTONES
}

enum UceCampaignObjective {
  BRAND_AWARENESS
  TRAFFIC_CLICKS
  SALES_CONVERSIONS
}

enum UceCompensationType {
  FIXED_FEE
  NEGOTIABLE
}

enum UcePayoutTerms {
  IMMEDIATE
  NET_7
  NET_15
  NET_30
}

enum UceCollabStatus {
  PROSPECT_CURATED
  PROSPECT_INVITED
  APPLICANT_PENDING
  APPLICANT_SHORTLISTED
  APPLICANT_REJECTED
  ACTIVE_WORKFLOW
  TERMINATED_CANCELED
  ARCHIVED_COMPLETE
}

enum UceMilestoneStage {
  STAGE_1_NEGOTIATION
  STAGE_2_SECUREMENT
  STAGE_3_LOGISTICS
  STAGE_4_CONTENT_REVIEW
  STAGE_5_PUBLISHING
  STAGE_6_FEEDBACK_SYNC
}

enum UcePipelineHealthStatus {
  ON_TRACK
  APPROACHING_DEADLINE
  ACTION_OVERDUE
  SYSTEM_HOLD
}

enum UceNegotiationSubState {
  BRAND_COUNTER
  CREATOR_COUNTER
  FINAL_OFFER_PENDING
}

enum UceSecurementSubState {
  AWAITING_FUNDING
  AWAITING_SIGNATURE
}

enum UceLogisticsSubState {
  AWAITING_DISPATCH
  IN_TRANSIT
  DELIVERY_EXCEPTION
}

enum UceReviewSubState {
  INITIAL_DRAFT_SUBMITTED
  REVISION_ROUND_ACTIVE
  CONTENT_HALTED_LOCK
}

enum UcePublishingSubState {
  AWAITING_LIVE_POST
  COMPLIANCE_CHECK_ACTIVE
}

enum UceMediaPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

// ============================================================================
// COLLABORATION (Unified Brand + Creator workflow)
// ============================================================================

enum CollaborationPayoutMode {
  ESCROW
  MANUAL
  BARTER
}

enum CollaborationIndustryType {
  D2C_ECOMMERCE
  HEALTHCARE_CLINICAL
  AI_SAAS
  OFFLINE_EXPERIENCES
}

enum FulfillmentIssueType {
  DAMAGED
  INVALID_CODE
  LOST
  TECH_ERROR
  NO_SHOW
}

enum CollaborationMediaPhase {
  SCRIPTING
  MEDIA
}

enum CollaborationMediaReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CollaborationEscrowStatus {
  AWAITING_FUNDS
  FUNDED
  PARTIAL_RELEASE
  SETTLED
  REFUNDED
}

enum CollaborationMessageKind {
  USER
  SYSTEM
}

// ============================================================================
// CORE MODELS (Organization & User)
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  brandProfile BrandProfile?

  @@map("organizations")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  /// Display name; brand onboarding sets local-part of work email.
  name           String?
  role           UserRole
  organizationId String?         @map("organization_id")
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  discoveryLeads DiscoveryLead[]
  creatorProfile CreatorProfile?
  collaborationsAsCreator Collaboration[] @relation("CollaborationCreator")

  @@index([organizationId])
  @@index([role])
  @@map("users")
}

// ============================================================================
// DISCOVERY MODELS (Step 1)
// ============================================================================

model DiscoveryLead {
  id            String              @id @default(uuid())
  rawUrl        String              @map("raw_url")
  normalizedUrl String              @unique @map("normalized_url")
  status        DiscoveryLeadStatus @default(PENDING)
  isSupported   Boolean             @default(false) @map("is_supported")
  industry      IndustryVertical?
  subIndustry   String?             @map("sub_industry")
  industryNiche String?             @map("industry_niche")
  securityScore Int                 @default(0) @map("security_score")
  metaHandshake Boolean             @default(false) @map("meta_handshake")
  userId        String?             @map("user_id")
  user          User?               @relation(fields: [userId], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")
  waitlistLeads WaitlistLead[]

  @@index([createdAt])
  @@index([userId])
  @@map("discovery_leads")
}

model MarketIntelligenceLog {
  id               String                   @id @default(uuid())
  domainName       String                   @unique @map("domain_name")
  detectedIndustry IndustryVertical         @map("detected_industry")
  rejectionType    MarketIntelRejectionType @map("rejection_type")
  geoLocation      String?                  @map("geo_location")
  attemptCount     Int                      @default(1) @map("attempt_count")
  lastAttempt      DateTime                 @default(now()) @map("last_attempt")
  waitlistLeads    WaitlistLead[]

  @@index([lastAttempt])
  @@map("market_intelligence_logs")
}

model WaitlistLead {
  id                      String                 @id @default(uuid())
  email                   String
  industryInterest        IndustryVertical       @map("industry_interest")
  isNotified              Boolean                @default(false) @map("is_notified")
  discoveryLeadId         String?                @map("discovery_lead_id")
  discoveryLead           DiscoveryLead?         @relation(fields: [discoveryLeadId], references: [id])
  marketIntelligenceLogId String?                @map("market_intelligence_log_id")
  marketIntelligenceLog   MarketIntelligenceLog? @relation(fields: [marketIntelligenceLogId], references: [id])
  createdAt               DateTime               @default(now()) @map("created_at")

  @@index([email])
  @@index([discoveryLeadId])
  @@index([marketIntelligenceLogId])
  @@map("waitlist_leads")
}

model SurfaceScanAttempt {
  id              String                 @id @default(uuid())
  domain          String
  clientIp        String                 @map("client_ip")
  discoveryLeadId String?                @map("discovery_lead_id")
  brandProfileId  String?                @map("brand_profile_id")
  kind            SurfaceScanAttemptKind @default(SURFACE_VENDOR)
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([domain, createdAt])
  @@index([clientIp, createdAt])
  @@map("surface_scan_attempts")
}

// ============================================================================
// BRAND ONBOARDING & LIFECYCLE MODELS
// ============================================================================

model BrandProfile {
  id                      String           @id @default(uuid())
  organizationId          String?          @unique @map("organization_id")
  organization            Organization?    @relation(fields: [organizationId], references: [id])
  domain                  String           @unique
  name                    String           @map("brand_name")
  industry                IndustryVertical
  subIndustry             String?          @map("sub_industry")
  industryNiche           String?          @map("industry_niche")
  logoUrl                 String?          @map("logo_url")
  tagline                 String?
  description             String?
  /// Official social profile URLs (e.g. Instagram / TikTok) from surface scan (product Prompt 1).
  socialLinks             String[]         @default([]) @map("social_links")
  /// Banner offers / coupon codes detected during surface scan (product Prompt 2).
  surfaceOffers           Json?            @map("surface_offers")
  /// Parallel markdown bundles from surface scan — Prompt 1 input (REQ-AI-001).
  surfaceScrapeBundles    String?          @map("surface_scrape_bundles") @db.Text
  /// Last authenticated Brand Centre API activity — session eviction (REQ-EVT-004).
  brandCentreLastActiveAt DateTime?        @map("brand_centre_last_active_at")
  visualIdentity          Json?            @map("visual_identity")
  brandValues             String[]         @map("brand_values")
  policyFlags             String[]         @map("policy_flags")
  targetAudience          Json?            @map("target_audience")

  // Step 6: Verification
  isVerified        Boolean   @default(false) @map("is_verified")
  verifiedAt        DateTime? @map("verified_at")
  verificationEmail String?   @map("verification_email")

  // Step 7: Deep Intel
  scanStatus      ScanStatus  @default(PENDING) @map("scan_status")
  deepIntelStatus IntelStatus @default(PENDING) @map("deep_intel_status")

  // Regional Context (Captured in Step 2)
  countryCode  String? @map("country_code")
  currencyCode String  @default("USD") @map("currency_code")

  // Subscription State (Step 8)
  planType           PlanType           @default(FREE_TRIAL) @map("plan_type")
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")
  planStartedAt      DateTime?          @map("plan_started_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")

  // Usage Tracking (Beta Buffer)
  deepScanCount   Int @default(0) @map("deep_scan_count")
  competitorCount Int @default(0) @map("competitor_count")
  outreachCount   Int @default(0) @map("outreach_count")

  // Brand Centre — Tab 1 routing & DNA
  brandRoutingType    BrandRoutingType @default(D2C_SKINCARE) @map("brand_routing_type")
  lifecycleStage      String           @default("GROWTH_STAGE") @map("lifecycle_stage")
  strategicDna        Json?            @map("strategic_dna")
  igHandle            String?          @map("ig_handle")
  ytHandle            String?          @map("yt_handle")
  tiktokHandle        String?          @map("tiktok_handle")
  deepScanCompletedAt DateTime?        @map("deep_scan_completed_at")

  isUserEdited Json?    @map("is_user_edited")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  offerings              Offering[]
  competitors            Competitor[]
  locations              Location[]
  subscriptions          Subscription[]
  teamInvitations        TeamInvitation[]
  brandCentreJobs        BrandCentreJob[]
  budgetConfiguration    BrandBudgetConfiguration?
  audiencePersonas       BrandAudiencePersona[]
  brandOffers            BrandOffer[]
  budgetModificationLogs BrandBudgetModificationLog[]
  intelligenceBaseline   BrandIntelligenceBaseline?
  performanceLeaks       BrandPerformanceLeak[]
  plannerCards           BrandPlannerCard[]

  // UCE (Universal Campaign Engine)
  uceCampaigns UceCampaign[]

  // Bridge ledger (Brand Centre → UCE)
  integrationBridgeSignals IntegrationBridgeSignalLedger[]

  collaborations Collaboration[]

  @@map("brand_profiles")
}

model Offering {
  id                 String       @id @default(uuid())
  brandProfileId     String       @map("brand_profile_id")
  brandProfile       BrandProfile @relation(fields: [brandProfileId], references: [id])
  type               OfferingType
  name               String
  description        String?
  imageUrl           String?      @map("image_url")
  url                String       @map("offering_url")
  /// Collection or healthcare specialty label from list pages (product Prompt 2).
  categoryTag        String?      @map("category_tag")
  /// Human-visible starting price from list view, before deep scan parses `priceAmount`.
  startingPriceLabel String?      @map("starting_price_label")
  priceAmount        Decimal?     @map("price_amount")
  currency           String       @default("USD")
  locationIds        String[]     @map("location_ids")
  isActive           Boolean      @default(true) @map("is_active")
  isDeepScanned      Boolean      @default(false) @map("is_deep_scanned")
  isUserEdited       Boolean      @default(false) @map("is_user_edited")
  sellingPoints      String[]     @default([]) @map("selling_points")
  doNotSay           String[]     @default([]) @map("do_not_say")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("offerings")
}

model Location {
  id             String       @id @default(uuid())
  brandProfileId String       @map("brand_profile_id")
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])
  name           String?
  address        String
  city           String?
  zip            String?
  lat            Float?
  lng            Float?
  contactDetails Json?        @map("contact_details")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("locations")
}

model Competitor {
  id             String       @id @default(uuid())
  brandProfileId String       @map("brand_profile_id")
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])
  name           String
  websiteUrl     String       @map("website_url")
  logoUrl        String?      @map("logo_url")
  socialHandles  String[]     @map("social_handles")
  whyCompetitor  String?      @map("why_competitor")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("competitors")
}

model VerificationCode {
  id         String   @id @default(uuid())
  identifier String   @map("identifier") // Email or brand_profile_id
  code       String
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false) @map("is_used")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification_codes")
}

model Subscription {
  id               String       @id @default(uuid())
  brandProfileId   String       @map("brand_profile_id")
  brandProfile     BrandProfile @relation(fields: [brandProfileId], references: [id])
  stripeCustomerId String?      @map("stripe_customer_id")
  amount           Decimal      @default(99.00) @db.Decimal(10, 2)
  currency         String       @default("USD")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("subscriptions")
}

model TeamInvitation {
  id             String       @id @default(uuid())
  email          String
  role           String       @default("ADMIN")
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  brandProfileId String       @map("brand_profile_id")
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])
  token          String       @unique
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")

  @@map("team_invitations")
}

model BrandCentreJob {
  id             String               @id @default(uuid())
  brandProfileId String               @map("brand_profile_id")
  brandProfile   BrandProfile         @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  type           BrandCentreJobType
  status         BrandCentreJobStatus @default(QUEUED)
  payload        Json?
  attempt        Int                  @default(0)
  errorMessage   String?              @map("error_message")
  queuedAt       DateTime             @default(now()) @map("queued_at")
  startedAt      DateTime?            @map("started_at")
  finishedAt     DateTime?            @map("finished_at")

  @@index([brandProfileId, type, status])
  @@map("brand_centre_jobs")
}

model BrandBudgetConfiguration {
  id                  String                @id @default(uuid())
  brandProfileId      String                @unique @map("brand_profile_id")
  brandProfile        BrandProfile          @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  masterMonthlyBudget Decimal               @map("master_monthly_budget") @db.Decimal(14, 2)
  allocationPhase     BudgetAllocationPhase @default(PHASE_1_COLD_START) @map("allocation_phase")
  assetMix            Json                  @map("asset_mix")
  tierMix             Json                  @map("tier_mix")
  objectiveMix        Json                  @map("objective_mix")
  utilizedBooked      Decimal               @default(0) @map("utilized_booked") @db.Decimal(14, 2)
  utilizedSpent       Decimal               @default(0) @map("utilized_spent") @db.Decimal(14, 2)
  aiExplanationText   String?               @map("ai_explanation_text")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@map("brand_budget_configurations")
}

model BrandAudiencePersona {
  id                 String       @id @default(uuid())
  brandProfileId     String       @map("brand_profile_id")
  brandProfile       BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  personaName        String       @map("persona_name")
  demographicsJson   Json         @map("demographics_json")
  psychographicsText String?      @map("psychographics_text")
  sortOrder          Int          @default(0) @map("sort_order")
  isUserEdited       Boolean      @default(false) @map("is_user_edited")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([brandProfileId])
  @@map("brand_audience_personas")
}

model BrandOffer {
  id                 String       @id @default(uuid())
  brandProfileId     String       @map("brand_profile_id")
  brandProfile       BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  offerName          String       @map("offer_name")
  promoCode          String       @map("promo_code")
  applicabilityScope String       @map("applicability_scope")
  validityStart      DateTime     @map("validity_start")
  validityEnd        DateTime     @map("validity_end")
  description        String?
  entityLink         String?      @map("entity_link")
  termsText          String?      @map("terms_text")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@unique([brandProfileId, promoCode])
  @@map("brand_offers")
}

model BrandBudgetModificationLog {
  id             String       @id @default(uuid())
  brandProfileId String       @map("brand_profile_id")
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  oldBudget      Decimal      @map("old_budget") @db.Decimal(14, 2)
  newBudget      Decimal      @map("new_budget") @db.Decimal(14, 2)
  modifiedAt     DateTime     @default(now()) @map("modified_at")

  @@index([brandProfileId, modifiedAt])
  @@map("brand_budget_modification_logs")
}

model BrandIntelligenceBaseline {
  id                 String       @id @default(uuid())
  brandProfileId     String       @unique @map("brand_profile_id")
  brandProfile       BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  growthImpactMatrix Json         @map("growth_impact_matrix")
  baselineHealth     Json         @map("baseline_health")
  shareOfVoice       Json         @map("share_of_voice")
  source             String       @default("ai_inferred")
  refreshedAt        DateTime?    @map("refreshed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("brand_intelligence_baselines")
}

model BrandPerformanceLeak {
  id                      String            @id @default(uuid())
  brandProfileId          String            @map("brand_profile_id")
  brandProfile            BrandProfile      @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  insightTitle            String            @map("insight_title")
  shortDescription        String            @map("short_description")
  priorityRank            PriorityRank      @map("priority_rank")
  leakBucket              LeakBucket        @map("leak_bucket")
  performanceStatus       PerformanceColor  @map("performance_status")
  projectedLiftPercentage Decimal           @map("projected_lift_percentage") @db.Decimal(6, 2)
  drawerDeepDive          Json              @map("drawer_deep_dive")
  plannerStatus           LeakPlannerStatus @default(PENDING_USER_REVIEW) @map("planner_status")
  plannerCardId           String?           @map("planner_card_id")
  plannerCard             BrandPlannerCard? @relation(fields: [plannerCardId], references: [id], onDelete: SetNull)
  isArchived              Boolean           @default(false) @map("is_archived")
  archivedAt              DateTime?         @map("archived_at")
  movedByUserId           String?           @map("moved_by_user_id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  @@index([brandProfileId, isArchived, priorityRank])
  @@map("brand_performance_leaks")
}

model BrandPlannerCard {
  id                       String                 @id @default(uuid())
  brandProfileId           String                 @map("brand_profile_id")
  brandProfile             BrandProfile           @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  cardType                 PlannerCardType        @map("card_type")
  aggregationKey           Json                   @map("aggregation_key")
  existingTargetCampaignId String?                @map("existing_target_campaign_id")
  campaignMetadata         Json                   @map("campaign_metadata")
  assetsAndBriefsMatrix    Json                   @map("assets_and_briefs_matrix")
  workflowStatus           PlannerWorkflowStatus  @default(PENDING_USER_REVIEW) @map("workflow_status")
  sourceLeakId             String?                @map("source_leak_id")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  sourceLeaks              BrandPerformanceLeak[]

  @@index([brandProfileId, workflowStatus])
  @@map("brand_planner_cards")
}

// ============================================================================
// UCE (Universal Campaign Engine) MODELS
// ============================================================================

model UceCampaign {
  id             String            @id @default(uuid())
  brandProfileId String            @map("brand_profile_id")
  brandProfile   BrandProfile      @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  name           String            @map("campaign_name")
  status         UceCampaignStatus @default(DRAFT) @map("current_status")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  performanceAggregate UceCampaignPerformanceAggregate?
  strategy             UceCampaignStrategy?
  targeting            UceCampaignTargeting?
  commercials          UceCampaignCommercials?
  products             UceCampaignProduct[]
  briefs               UceCampaignBrief[]
  collaborations       UceCampaignCollaboration[]
  workflowCollaborations Collaboration[]
  reportingSnapshots   UceCampaignReportingSnapshot[]
  reportingTimeseries  UceCampaignReportingTimeseriesHourly[]
  reportingAssets      UceCampaignReportingAssetGallery[]
  bridgeSignals        IntegrationBridgeSignalLedger[]

  @@index([brandProfileId, status])
  @@map("uce_campaigns")
}

model UceCampaignPerformanceAggregate {
  campaignId              String      @id @map("campaign_id")
  campaign                UceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  totalSpendToDate        Decimal     @default(0) @map("total_spend_to_date") @db.Decimal(14, 2)
