  totalQuote     Decimal @default(0) @map("total_quote") @db.Decimal(12, 2)
  advance30Value Decimal @default(0) @map("advance_30_value") @db.Decimal(12, 2)
  balance70Value Decimal @default(0) @map("balance_70_value") @db.Decimal(12, 2)

  logisticsCarrier        String? @map("logistics_carrier")
  logisticsTrackingNumber String? @map("logistics_tracking_number")
  contentDraftUrl         String? @map("content_draft_url")
