model Collaboration {
  id             String       @id @default(uuid())
  brandProfileId String       @map("brand_id")
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  creatorUserId  String       @map("creator_id")
  creatorUser    User         @relation("CollaborationCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  campaignId     String       @map("campaign_id")
  campaign       UceCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  briefId        String       @map("brief_id")
  brief          UceCampaignBrief @relation(fields: [briefId], references: [id], onDelete: Restrict)
  productId      String?      @map("product_id")
  product        UceCampaignProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  ucePipelineCollaborationId String?                  @unique @map("uce_pipeline_collaboration_id")
  ucePipelineCollaboration   UceCampaignCollaboration? @relation(fields: [ucePipelineCollaborationId], references: [id], onDelete: SetNull)

  currentStage UceMilestoneStage       @default(STAGE_1_NEGOTIATION) @map("current_stage")
  payoutMode   CollaborationPayoutMode @default(ESCROW) @map("payout_mode")
  industry     CollaborationIndustryType

  negotiationRound      Int @default(0) @map("negotiation_round")
  fulfillmentIssueCount Int @default(0) @map("fulfillment_issue_count")
  revisionCount         Int @default(0) @map("revision_count")

  unreadCountBrand   Int     @default(0) @map("unread_count_brand")
  unreadCountCreator Int     @default(0) @map("unread_count_creator")
  lastMessageSnippet String? @map("last_message_snippet")
  lastMessageAt      DateTime? @map("last_message_at")
  stageUpdatedAt     DateTime @default(now()) @map("stage_updated_at")

  isPaused      Boolean @default(false) @map("is_paused")
  isTerminated  Boolean @default(false) @map("is_terminated")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  commercials    CollaborationCommercial?
  logistics      CollaborationLogistics?
  media          CollaborationMedia[]
  finalization   CollaborationFinalization?
  messages       CollaborationMessage[]

  @@unique([campaignId, creatorUserId])
  @@index([brandProfileId, currentStage])
  @@index([creatorUserId, currentStage])
  @@index([lastMessageAt])
  @@map("collaborations")
}

