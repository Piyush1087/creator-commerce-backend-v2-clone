  threadId         String                @map("thread_id")
  thread           CreatorCoPilotThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  creatorProfileId String                @map("creator_profile_id")
  creatorProfile   CreatorProfile        @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  userId           String                @map("user_id")
  user             User                  @relation(fields: [userId], references: [id])
  rating           CoPilotFeedbackRating
  reason           String?
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([creatorProfileId, createdAt])
  @@map("creator_co_pilot_message_feedback")
}

model CreatorCoPilotSlotSession {
  id                     String               @id @default(uuid())
  threadId               String               @unique @map("thread_id")
  thread                 CreatorCoPilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  intentWorkspaceContext String               @map("intent_workspace_context")
  stagedPayload          Json                 @map("staged_payload")
  missingSlots           Json                 @map("missing_slots")
  expiresAt              DateTime             @map("expires_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@map("creator_co_pilot_slot_sessions")
}

model CreatorCoPilotInteractionLog {
  id                 String                     @id @default(uuid())
  creatorProfileId   String                     @map("creator_profile_id")
  creatorProfile     CreatorProfile             @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  userId             String                     @map("user_id")
  threadId           String?                    @map("thread_id")
  thread             CreatorCoPilotThread?      @relation("CreatorCoPilotThreadLogs", fields: [threadId], references: [id], onDelete: SetNull)
  messageId          String?                    @map("message_id")
  scopeContext       CreatorCoPilotScopeContext @map("scope_context")
  intentKey          String?                    @map("intent_key")
  modelId            String                     @map("model_id")
  inputTokens        Int?                       @map("input_tokens")
  outputTokens       Int?                       @map("output_tokens")
  estimatedCostMinor Int?                       @map("estimated_cost_minor")
  toolsInvoked       String[]                   @default([]) @map("tools_invoked")
  status             CoPilotInteractionStatus
  latencyMs          Int?                       @map("latency_ms")
  idempotencyKey     String?                    @map("idempotency_key")
  errorCode          String?                    @map("error_code")
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([creatorProfileId, createdAt])
  @@map("creator_co_pilot_interaction_logs")
}

// ============================================================================
// NOTIFICATIONS MODULE (Phase 1 — Postgres job queue, no Redis)
// ============================================================================

model Notification {
  id            String                   @id @default(uuid())
  workspaceId   String                   @map("workspace_id")
  brandProfile  BrandProfile             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggerUserId String?                  @map("trigger_user_id")
  triggerUser   User?                    @relation("NotificationTriggerUser", fields: [triggerUserId], references: [id], onDelete: SetNull)
  eventType     String                   @map("event_type") @db.VarChar(100)
  urgencyLevel  NotificationUrgencyLevel @map("urgency_level")
  payload       Json
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  recipients NotificationRecipient[]

  @@index([workspaceId])
  @@index([workspaceId, eventType, createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false) @map("is_read")
  isEmailed      Boolean      @default(false) @map("is_emailed")
  readAt         DateTime?    @map("read_at")

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@map("notification_recipients")
}

model NotificationJob {
  id            String                   @id @default(uuid())
  workspaceId   String                   @map("workspace_id")
  eventType     String                   @map("event_type") @db.VarChar(100)
  urgencyLevel  NotificationUrgencyLevel @map("urgency_level")
  triggerUserId String?                  @map("trigger_user_id")
  payload       Json
  actorName     String?                  @map("actor_name") @db.VarChar(200)
  status        NotificationJobStatus    @default(PENDING)
  attempts      Int                      @default(0)
  maxAttempts   Int                      @default(5) @map("max_attempts")
  scheduledAt   DateTime                 @default(now()) @map("scheduled_at")
  lockedAt      DateTime?                @map("locked_at")
  lockedBy      String?                  @map("locked_by") @db.VarChar(100)
  lastError     String?                  @map("last_error") @db.Text
  completedAt   DateTime?                @map("completed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@map("notification_jobs")
}
