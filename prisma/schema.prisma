// ============================================================================
// CORE MODELS (Organization & User)
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  brandProfile BrandProfile?

  @@map("organizations")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  /// Display name; brand onboarding sets local-part of work email.
  name           String?
  /// Scrypt hash for creator email/password signup.
  hashedPassword String?         @map("hashed_password")
  /// Google OAuth subject (`sub` claim) for creator Google signup/sign-in.
  googleSubjectId String?        @unique @map("google_subject_id")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  role           UserRole
  organizationId String?         @map("organization_id")
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  discoveryLeads DiscoveryLead[]
  creatorProfile CreatorProfile?
  creatorOnboardingTrack CreatorOnboardingTrack?
  userProfile UserProfile?
  historicChatThreads HistoricChatThread[]
  metricPostPulses MetricPostPulse[]
  collaborationsAsCreator Collaboration[] @relation("CollaborationCreator")
  uceCampaignCreatorLinks UceCampaignCreator[] @relation("UceCampaignCreatorUser")
  coPilotThreads CoPilotThread[]
  coPilotMessageFeedback CoPilotMessageFeedback[]
  creatorCoPilotThreadsAuthored CreatorCoPilotThread[] @relation("CreatorCoPilotThreadAuthor")
  creatorCoPilotMessageFeedback CreatorCoPilotMessageFeedback[]
  brandTeamMemberships BrandTeamMember[]
  triggeredNotifications Notification[] @relation("NotificationTriggerUser")
  notificationRecipients NotificationRecipient[]

  @@index([organizationId])
  @@index([role])
  @@map("users")
}

// ============================================================================
// DISCOVERY MODELS (Step 1)
// ============================================================================

model DiscoveryLead {
  id            String              @id @default(uuid())
  rawUrl        String              @map("raw_url")
  normalizedUrl String              @unique @map("normalized_url")
  status        DiscoveryLeadStatus @default(PENDING)
  isSupported   Boolean             @default(false) @map("is_supported")
  industry      IndustryVertical?
  subIndustry   String?             @map("sub_industry")
  industryNiche String?             @map("industry_niche")
  securityScore Int                 @default(0) @map("security_score")
  metaHandshake Boolean             @default(false) @map("meta_handshake")
  /// Step 1 session cache payload (AI classification output — populated when Neika/Invuet pipeline ships).
  temporaryPayload       Json?     @map("temporary_payload")
  /// TTL for unverified Step 1 cache rows (change doc: 7-day horizon).
  expiresAt              DateTime? @map("expires_at")
  signupCompleted        Boolean   @default(false) @map("signup_completed")
  classificationEvidence String?   @map("classification_evidence") @db.VarChar(250)
  userId        String?             @map("user_id")
  user          User?               @relation(fields: [userId], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")
  waitlistLeads          WaitlistLead[]
  brandIntelligenceScan  BrandIntelligenceScan?
  intelligenceJobs       BrandIntelligenceJob[]

  @@index([createdAt])
  @@index([userId])
  @@index([normalizedUrl, signupCompleted, expiresAt], map: "idx_discovery_cache_lookup")
  @@map("discovery_leads")
}

/// Brand Intelligence pipeline state (Checkpoint 1 → Stage 1B → Brand DNA).
/// Replaces ad-hoc temporaryPayload.stage1a/stage1b for Phases 4–7.
model BrandIntelligenceScan {
  id                       String                 @id @default(uuid())
  discoveryLeadId          String                 @unique @map("discovery_lead_id")
  discoveryLead            DiscoveryLead          @relation(fields: [discoveryLeadId], references: [id], onDelete: Cascade)
  brandProfileId           String?                @map("brand_profile_id")
  brandProfile             BrandProfile?          @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  websiteUrl               String                 @map("website_url")
  currentStage             BrandIntelligenceStage @map("current_stage")
  stage1aSnapshot          Json?                  @map("stage1a_snapshot")
  authoritativeIdentity    Json?                  @map("authoritative_identity")
  runtimeContext           Json?                  @map("runtime_context")
  brandDnaRaw              Json?                  @map("brand_dna_raw")
  brandDnaVerifiedSnapshot Json?                  @map("brand_dna_verified_snapshot")
  checkpoint2Confirmation  Json?                  @map("checkpoint2_confirmation")
  errorLogs                String?                @map("error_logs") @db.Text
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  intelligenceJobs         BrandIntelligenceJob[]

  @@index([brandProfileId])
  @@index([currentStage])
  @@map("brand_intelligence_scans")
}

/// Durable queue for Stage 1B → Prompt A pipeline after Checkpoint 1.
model BrandIntelligenceJob {
  id              String                     @id @default(uuid())
  discoveryLeadId String                     @map("discovery_lead_id")
  discoveryLead   DiscoveryLead              @relation(fields: [discoveryLeadId], references: [id], onDelete: Cascade)
  scanId          String?                    @map("scan_id")
  scan            BrandIntelligenceScan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)
  type            BrandIntelligenceJobType   @default(STAGE_1B_PIPELINE)
  status          BrandIntelligenceJobStatus @default(QUEUED)
  payload         Json?
  attempt         Int                        @default(0)
  maxAttempts     Int                        @default(3) @map("max_attempts")
  errorMessage    String?                    @map("error_message") @db.Text
  queuedAt        DateTime                   @default(now()) @map("queued_at")
  startedAt       DateTime?                  @map("started_at")
  finishedAt      DateTime?                  @map("finished_at")

  @@index([status, queuedAt])
  @@index([discoveryLeadId])
  @@map("brand_intelligence_jobs")
}

model MarketIntelligenceLog {
  id               String                   @id @default(uuid())
  domainName       String                   @unique @map("domain_name")
  detectedIndustry IndustryVertical         @map("detected_industry")
  rejectionType    MarketIntelRejectionType @map("rejection_type")
  geoLocation      String?                  @map("geo_location")
  attemptCount     Int                      @default(1) @map("attempt_count")
  lastAttempt      DateTime                 @default(now()) @map("last_attempt")
  waitlistLeads    WaitlistLead[]

  @@index([lastAttempt])
  @@map("market_intelligence_logs")
}

model WaitlistLead {
  id                      String                 @id @default(uuid())
  email                   String
  industryInterest        IndustryVertical       @map("industry_interest")
  domain                  String?                @db.VarChar(255)
  reason                  WaitlistReason?        @map("reason")
  isNotified              Boolean                @default(false) @map("is_notified")
  discoveryLeadId         String?                @map("discovery_lead_id")
  discoveryLead           DiscoveryLead?         @relation(fields: [discoveryLeadId], references: [id])
  marketIntelligenceLogId String?                @map("market_intelligence_log_id")
  marketIntelligenceLog   MarketIntelligenceLog? @relation(fields: [marketIntelligenceLogId], references: [id])
  creatorOnboardingTrack  CreatorOnboardingTrack?
  createdAt               DateTime               @default(now()) @map("created_at")

  @@index([email])
  @@index([domain])
  @@index([discoveryLeadId])
  @@index([marketIntelligenceLogId])
  @@map("waitlist_leads")
}

model SurfaceScanAttempt {
  id              String               …23128 tokens truncated…l(15, 4)
  currency                   String                  @db.VarChar(3)
  gatewayProcessingSurcharge Decimal                 @default(0) @map("gateway_processing_surcharge") @db.Decimal(15, 4)
  gatewaySurchargeGst        Decimal                 @default(0) @map("gateway_surcharge_gst") @db.Decimal(15, 4)
  idempotencyKey             String                  @unique @map("idempotency_key")
  gatewayReferenceId         String?                 @unique @map("gateway_reference_id")
  transactionStatus          EscrowTransactionStatus @default(PROCESSING_GATEWAY) @map("transaction_status")
  errorDiagnosticPayload     Json?                   @map("error_diagnostic_payload")
  createdAt                  DateTime                @default(now()) @map("created_at")

  @@index([vaultId])
  @@index([brandProfileId, collaborationId, transactionType])
  @@index([collaborationId])
  @@map("escrow_transaction_ledger")
}

model CreatorSettlementProfile {
  id                    String         @id @default(uuid()) @map("settlement_profile_id")
  creatorProfileId      String         @unique @map("creator_profile_id")
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  accountHolderName     String         @map("account_holder_name")
  bankAccountNumber     String         @map("bank_account_number")
  ifscCode              String         @map("ifsc_code")
  panNumber             String?        @map("pan_number") @db.VarChar(10)
  isPanVerified         Boolean        @default(false) @map("is_pan_verified")
  razorpayFundAccountId String?        @unique @map("razorpay_fund_account_id")
  isSettlementRouteActive Boolean      @default(false) @map("is_settlement_route_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([creatorProfileId])
  @@map("creator_settlement_profiles")
}

model IdempotencyRegistry {
  idempotencyKey String                    @id @map("idempotency_key")
  requestPath    String                    @map("request_path")
  executionState IdempotencyExecutionState @default(IN_FLIGHT) @map("execution_state")
  cachedResponse Json?                     @map("cached_response")
  lockedAt       DateTime                  @default(now()) @map("locked_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@map("idempotency_registry")
}

// ---------------------------------------------------------------------------
// Pricing — subscription lifecycle & entitlement (product: brand_subscriptions)
// ---------------------------------------------------------------------------

model BrandSubscription {
  id                     String               @id @default(uuid()) @map("subscription_id")
  brandProfileId         String               @unique @map("brand_id")
  brandProfile           BrandProfile         @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  tier                   SubscriptionTier     @default(FOUNDERS_BETA)
  status                 SubscriptionStatus   @default(TRIALING)
  currency               SubscriptionCurrency @default(USD)
  razorpayCustomerId     String?              @map("razorpay_customer_id")
  razorpaySubscriptionId String?              @unique @map("razorpay_subscription_id")
  razorpayPlanId         String?              @map("razorpay_plan_id")
  trialEndsAt            DateTime?            @map("trial_ends_at")
  currentPeriodStart     DateTime             @default(now()) @map("current_period_start")
  currentPeriodEnd       DateTime             @map("current_period_end")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  featureUsages   FeatureUsage[]
  billingInvoices BrandBillingInvoice[]

  @@index([brandProfileId])
  @@index([status])
  @@map("brand_subscriptions")
}

model BrandBillingInvoice {
  id                     String            @id @default(uuid()) @map("invoice_row_id")
  brandProfileId         String            @map("brand_id")
  brandSubscriptionId    String            @map("subscription_id")
  brandSubscription      BrandSubscription @relation(fields: [brandSubscriptionId], references: [id], onDelete: Cascade)
  razorpayInvoiceId      String            @unique @map("razorpay_invoice_id")
  razorpaySubscriptionId String            @map("razorpay_subscription_id")
  razorpayPaymentId      String?           @map("razorpay_payment_id")
  shortUrl               String?           @map("short_url")
  status                 String
  amount                 Int
  amountPaid             Int               @default(0) @map("amount_paid")
  currency               String            @default("USD")
  invoiceNumber          String?           @map("invoice_number")
  paidAt                 DateTime?         @map("paid_at")
  billingPeriodStart     DateTime?         @map("billing_period_start")
  billingPeriodEnd       DateTime?         @map("billing_period_end")
  issuedAt               DateTime?         @map("issued_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  @@index([brandProfileId])
  @@index([brandSubscriptionId])
  @@index([paidAt])
  @@map("brand_billing_invoices")
}

model FeatureUsage {
  id                String            @id @default(uuid()) @map("usage_id")
  subscriptionId    String            @map("subscription_id")
  subscription      BrandSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  featureKey        String            @map("feature_key")
  currentUsageCount Int               @default(0) @map("current_usage_count")
  resetAt           DateTime?         @map("reset_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([subscriptionId, featureKey])
  @@map("feature_usages")
}

// ============================================================================
// CO-PILOT (Brand Home Chat Engine)
// ============================================================================

model CoPilotThread {
  id               String                  @id @default(uuid())
  brandProfileId   String                  @map("brand_profile_id")
  brandProfile     BrandProfile            @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  createdByUserId  String                  @map("created_by_user_id")
  createdByUser    User                    @relation(fields: [createdByUserId], references: [id])
  title            String
  scopeContext     CoPilotScopeContext     @default(BRAND_CENTRE) @map("scope_context")
  linkedEntityType CoPilotLinkedEntityType @default(NONE) @map("linked_entity_type")
  linkedEntityId   String?                 @map("linked_entity_id")
  archivedAt       DateTime?               @map("archived_at")
  lastMessageAt    DateTime                @map("last_message_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  messages        CoPilotMessage[]
  messageFeedback CoPilotMessageFeedback[]
  slotSession     CoPilotSlotSession?
  interactionLogs CoPilotInteractionLog[] @relation("CoPilotThreadLogs")

  @@index([brandProfileId, lastMessageAt(sort: Desc)])
  @@index([brandProfileId, archivedAt])
  @@map("co_pilot_threads")
}

enum CoPilotFeedbackRating {
  THUMBS_UP
  THUMBS_DOWN
}

model CoPilotMessage {
  id          String              @id @default(uuid())
  threadId    String              @map("thread_id")
  thread      CoPilotThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role        CoPilotMessageRole
  textContent String?             @map("text_content") @db.Text
  payloadJson Json?               @map("payload_json")
  formatType  CoPilotFormatType?  @map("format_type")
  createdAt   DateTime            @default(now()) @map("created_at")
  feedback    CoPilotMessageFeedback?

  @@index([threadId, createdAt])
  @@map("co_pilot_messages")
}

model CoPilotMessageFeedback {
  id             String                @id @default(uuid())
  messageId      String                @unique @map("message_id")
  message        CoPilotMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  threadId       String                @map("thread_id")
  thread         CoPilotThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  brandProfileId String                @map("brand_profile_id")
  brandProfile   BrandProfile          @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  userId         String                @map("user_id")
  user           User                  @relation(fields: [userId], references: [id])
  rating         CoPilotFeedbackRating
  reason         String?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([brandProfileId, createdAt])
  @@map("co_pilot_message_feedback")
}

model CoPilotSlotSession {
  id                     String        @id @default(uuid())
  threadId               String        @unique @map("thread_id")
  thread                 CoPilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  intentWorkspaceContext String        @map("intent_workspace_context")
  stagedPayload          Json          @map("staged_payload")
  missingSlots           Json          @map("missing_slots")
  expiresAt              DateTime      @map("expires_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@map("co_pilot_slot_sessions")
}

model CoPilotInteractionLog {
  id                 String                   @id @default(uuid())
  brandProfileId     String                   @map("brand_profile_id")
  brandProfile       BrandProfile             @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  userId             String                   @map("user_id")
  threadId           String?                  @map("thread_id")
  thread             CoPilotThread?           @relation("CoPilotThreadLogs", fields: [threadId], references: [id], onDelete: SetNull)
  messageId          String?                  @map("message_id")
  scopeContext       CoPilotScopeContext      @map("scope_context")
  intentKey          String?                  @map("intent_key")
  modelId            String                   @map("model_id")
  inputTokens        Int?                     @map("input_tokens")
  outputTokens       Int?                     @map("output_tokens")
  estimatedCostMinor Int?                     @map("estimated_cost_minor")
  toolsInvoked       String[]                 @default([]) @map("tools_invoked")
  status             CoPilotInteractionStatus
  latencyMs          Int?                     @map("latency_ms")
  idempotencyKey     String?                  @map("idempotency_key")
  errorCode          String?                  @map("error_code")
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@index([brandProfileId, createdAt])
  @@map("co_pilot_interaction_logs")
}

// ============================================================================
// CREATOR CO-PILOT (Creator Command Center Chat Engine)
// ============================================================================

model CreatorCoPilotThread {
  id               String                       @id @default(uuid())
  creatorProfileId String                       @map("creator_profile_id")
  creatorProfile   CreatorProfile               @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  createdByUserId  String                       @map("created_by_user_id")
  createdByUser    User                         @relation("CreatorCoPilotThreadAuthor", fields: [createdByUserId], references: [id])
