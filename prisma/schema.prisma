  feedback    CreatorCoPilotMessageFeedback?

  @@index([threadId, createdAt])
  @@map("creator_co_pilot_messages")
}

model CreatorCoPilotMessageFeedback {
  id               String                @id @default(uuid())
  messageId        String                @unique @map("message_id")
