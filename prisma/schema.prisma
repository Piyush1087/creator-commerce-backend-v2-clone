  autoApprovalDeadline72h  DateTime? @map("auto_approval_deadline_72h")
  currentMilestoneDeadline DateTime  @map("current_milestone_deadline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

