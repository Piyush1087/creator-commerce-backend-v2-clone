// ============================================================================
// CORE MODELS (Organization & User)
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  brandProfile BrandProfile?

  @@map("organizations")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  /// Display name; brand onboarding sets local-part of work email.
  name           String?
  /// Scrypt hash for creator email/password signup.
  hashedPassword String?         @map("hashed_password")
  /// Google OAuth subject (`sub` claim) for creator Google signup/sign-in.
  googleSubjectId String?        @unique @map("google_subject_id")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  role           UserRole
  organizationId String?         @map("organization_id")
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  discoveryLeads DiscoveryLead[]
  creatorProfile CreatorProfile?
  creatorOnboardingTrack CreatorOnboardingTrack?
  userProfile UserProfile?
  historicChatThreads HistoricChatThread[]
  metricPostPulses MetricPostPulse[]
  collaborationsAsCreator Collaboration[] @relation("CollaborationCreator")
  coPilotThreads CoPilotThread[]
  coPilotMessageFeedback CoPilotMessageFeedback[]
  creatorCoPilotThreadsAuthored CreatorCoPilotThread[] @relation("CreatorCoPilotThreadAuthor")
  creatorCoPilotMessageFeedback CreatorCoPilotMessageFeedback[]
  brandTeamMemberships BrandTeamMember[]
  triggeredNotifications Notification[] @relation("NotificationTriggerUser")
  notificationRecipients NotificationRecipient[]

  @@index([organizationId])
  @@index([role])
  @@map("users")
}

// ============================================================================
// DISCOVERY MODELS (Step 1)
// ============================================================================

model DiscoveryLead {
  id            String              @id @default(uuid())
  rawUrl        String              @map("raw_url")
  normalizedUrl String              @unique @map("normalized_url")
  status        DiscoveryLeadStatus @default(PENDING)
  isSupported   Boolean             @default(false) @map("is_supported")
  industry      IndustryVertical?
  subIndustry   String?             @map("sub_industry")
  industryNiche String?             @map("industry_niche")
  securityScore Int                 @default(0) @map("security_score")
  metaHandshake Boolean             @default(false) @map("meta_handshake")
  /// Step 1 session cache payload (AI classification output — populated when Neika/Invuet pipeline ships).
  temporaryPayload       Json?     @map("temporary_payload")
  /// TTL for unverified Step 1 cache rows (change doc: 7-day horizon).
  expiresAt              DateTime? @map("expires_at")
  signupCompleted        Boolean   @default(false) @map("signup_completed")
  classificationEvidence String?   @map("classification_evidence") @db.VarChar(250)
  userId        String?             @map("user_id")
  user          User?               @relation(fields: [userId], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")
  waitlistLeads          WaitlistLead[]
  brandIntelligenceScan  BrandIntelligenceScan?
  intelligenceJobs       BrandIntelligenceJob[]

  @@index([createdAt])
  @@index([userId])
  @@index([normalizedUrl, signupCompleted, expiresAt], map: "idx_discovery_cache_lookup")
  @@map("discovery_leads")
}

/// Brand Intelligence pipeline state (Checkpoint 1 → Stage 1B → Brand DNA).
/// Replaces ad-hoc temporaryPayload.stage1a/stage1b for Phases 4–7.
model BrandIntelligenceScan {
  id                       String                 @id @default(uuid())
  discoveryLeadId          String                 @unique @map("discovery_lead_id")
  discoveryLead            DiscoveryLead          @relation(fields: [discoveryLeadId], references: [id], onDelete: Cascade)
  brandProfileId           String?                @map("brand_profile_id")
  brandProfile             BrandProfile?          @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  websiteUrl               String                 @map("website_url")
  currentStage             BrandIntelligenceStage @map("current_stage")
  stage1aSnapshot          Json?                  @map("stage1a_snapshot")
  authoritativeIdentity    Json?                  @map("authoritative_identity")
  runtimeContext           Json?                  @map("runtime_context")
  brandDnaRaw              Json?                  @map("brand_dna_raw")
  brandDnaVerifiedSnapshot Json?                  @map("brand_dna_verified_snapshot")
  checkpoint2Confirmation  Json?                  @map("checkpoint2_confirmation")
  errorLogs                String?                @map("error_logs") @db.Text
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  intelligenceJobs         BrandIntelligenceJob[]

  @@index([brandProfileId])
  @@index([currentStage])
  @@map("brand_intelligence_scans")
}

/// Durable queue for Stage 1B → Prompt A pipeline after Checkpoint 1.
model BrandIntelligenceJob {
  id              String                     @id @default(uuid())
  discoveryLeadId String                     @map("discovery_lead_id")
  discoveryLead   DiscoveryLead              @relation(fields: [discoveryLeadId], references: [id], onDelete: Cascade)
  scanId          String?                    @map("scan_id")
  scan            BrandIntelligenceScan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)
  type            BrandIntelligenceJobType   @default(STAGE_1B_PIPELINE)
  status          BrandIntelligenceJobStatus @default(QUEUED)
  payload         Json?
  attempt         Int                        @default(0)
  maxAttempts     Int                        @default(3) @map("max_attempts")
  errorMessage    String?                    @map("error_message") @db.Text
  queuedAt        DateTime                   @default(now()) @map("queued_at")
  startedAt       DateTime?                  @map("started_at")
  finishedAt      DateTime?                  @map("finished_at")

  @@index([status, queuedAt])
  @@index([discoveryLeadId])
  @@map("brand_intelligence_jobs")
}

model MarketIntelligenceLog {
  id               String                   @id @default(uuid())
  domainName       String                   @unique @map("domain_name")
  detectedIndustry IndustryVertical         @map("detected_industry")
  rejectionType    MarketIntelRejectionType @map("rejection_type")
  geoLocation      String?                  @map("geo_location")
  attemptCount     Int                      @default(1) @map("attempt_count")
  lastAttempt      DateTime                 @default(now()) @map("last_attempt")
  waitlistLeads    WaitlistLead[]

  @@index([lastAttempt])
  @@map("market_intelligence_logs")
}

model WaitlistLead {
  id                      String                 @id @default(uuid())
  email                   String
  industryInterest        IndustryVertical       @map("industry_interest")
  domain                  String?                @db.VarChar(255)
  reason                  WaitlistReason?        @map("reason")
  isNotified              Boolean                @default(false) @map("is_notified")
  discoveryLeadId         String?                @map("discovery_lead_id")
  discoveryLead           DiscoveryLead?         @relation(fields: [discoveryLeadId], references: [id])
  marketIntelligenceLogId String?                @map("market_intelligence_log_id")
  marketIntelligenceLog   MarketIntelligenceLog? @relation(fields: [marketIntelligenceLogId], references: [id])
  creatorOnboardingTrack  CreatorOnboardingTrack?
  createdAt               DateTime               @default(now()) @map("created_at")

  @@index([email])
  @@index([domain])
  @@index([discoveryLeadId])
  @@index([marketIntelligenceLogId])
  @@map("waitlist_leads")
}

model SurfaceScanAttempt {
  id              String                 @id @default(uuid())
  domain          String
  clientIp        String                 @map("client_ip")
  discoveryLeadId String?                @map("discovery_lead_id")
  brandProfileId  String?                @map("brand_profile_id")
  kind            SurfaceScanAttemptKind @default(SURFACE_VENDOR)
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([domain, createdAt])
  @@index([clientIp, createdAt])
  @@map("surface_scan_attempts")
}

// ============================================================================
// BRAND ONBOARDING & LIFECYCLE MODELS
// ============================================================================

model BrandProfile {
  id                      String           @id @default(uuid())
  organizationId          String?          @unique @map("organization_id")
  organization            Organization?    @relation(fields: [organizationId], references: [id])
  domain                  String           @unique
  name                    String           @map("brand_name")
  industry                IndustryVertical
  subIndustry             String?          @map("sub_industry")
  industryNiche           String?          @map("industry_niche")
  logoUrl                 String?          @map("logo_url")
  tagline                 String?
  description             String?
  /// Official social profile URLs (e.g. Instagram / TikTok) from surface scan (product Prompt 1).
  socialLinks             String[]         @default([]) @map("social_links")
  /// Banner offers / coupon codes detected during surface scan (product Prompt 2).
  surfaceOffers           Json?            @map("surface_offers")
  /// Parallel markdown bundles from surface scan — Prompt 1 input (REQ-AI-001).
  surfaceScrapeBundles    String?          @map("surface_scrape_bundles") @db.Text
  /// Last authenticated Brand Centre API activity — session eviction (REQ-EVT-004).
  brandCentreLastActiveAt DateTime?        @map("brand_centre_last_active_at")
  visualIdentity          Json?            @map("visual_identity")
  brandValues             String[]         @map("brand_values")
  policyFlags             String[]         @map("policy_flags")
  targetAudience          Json?            @map("target_audience")

  // Step 6: Verification (isVerified flips only after password gate)
  isVerified        Boolean   @default(false) @map("is_verified")
  verifiedAt        DateTime? @map("verified_at")
  verificationEmail String?   @map("verification_email")
  /// Set when OTP/Google identity succeeds; password step still required for isVerified.
  identityConfirmedAt DateTime? @map("identity_confirmed_at")

  // Step 7: Deep Intel
  scanStatus      ScanStatus  @default(PENDING) @map("scan_status")
  deepIntelStatus IntelStatus @default(PENDING) @map("deep_intel_status")

  /// Step 8: brand skipped Instagram Login during onboarding.
  socialSyncSkipped Boolean @default(false) @map("social_sync_skipped")

  // Regional Context (Captured in Step 2)
  countryCode  String? @map("country_code")
  currencyCode String  @default("USD") @map("currency_code")

  // Subscription State (Step 8)
  planType           PlanType           @default(FREE_TRIAL) @map("plan_type")
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")
  planStartedAt      DateTime?          @map("plan_started_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")

  /// Payouts hub permission scope — Campaign Manager is read-only on funding actions.
  payoutsWorkspaceRole BrandPayoutsWorkspaceRole @default(FINANCE_ADMIN) @map("payouts_workspace_role")

  // Usage Tracking (Beta Buffer)
  deepScanCount   Int @default(0) @map("deep_scan_count")
  competitorCount Int @default(0) @map("competitor_count")
  outreachCount   Int @default(0) @map("outreach_count")

  // Brand Centre — Tab 1 routing & DNA
  brandRoutingType    BrandRoutingType @default(D2C_SKINCARE) @map("brand_routing_type")
  lifecycleStage      String           @default("GROWTH_STAGE") @map("lifecycle_stage")
  strategicDna        Json?            @map("strategic_dna")
  igHandle            String?          @map("ig_handle")
  ytHandle            String?          @map("yt_handle")
  tiktokHandle        String?          @map("tiktok_handle")
  deepScanCompletedAt DateTime?        @map("deep_scan_completed_at")

  isUserEdited Json?    @map("is_user_edited")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  offerings              Offering[]
  competitors            Competitor[]
  locations              Location[]
  subscriptions          Subscription[]
  teamInvitations        TeamInvitation[]
  brandCentreJobs        BrandCentreJob[]
  budgetConfiguration    BrandBudgetConfiguration?
  audiencePersonas       BrandAudiencePersona[]
  brandOffers            BrandOffer[]
  budgetModificationLogs BrandBudgetModificationLog[]
  intelligenceBaseline   BrandIntelligenceBaseline?
  performanceLeaks       BrandPerformanceLeak[]
  plannerCards           BrandPlannerCard[]
  brandIntelligenceScans BrandIntelligenceScan[]

  // UCE (Universal Campaign Engine)
  uceCampaigns UceCampaign[]

  // Bridge ledger (Brand Centre → UCE)
  integrationBridgeSignals IntegrationBridgeSignalLedger[]

  collaborations    Collaboration[]
  escrowVault       BrandEscrowVault?
  brandSubscription BrandSubscription?
  coPilotThreads           CoPilotThread[]
  coPilotInteractionLogs   CoPilotInteractionLog[]
  coPilotMessageFeedback   CoPilotMessageFeedback[]

  teamMembers          BrandTeamMember[]
  billingProfile       BrandBillingProfile?
  withdrawalAccounts   BrandWithdrawalAccount[]
  notificationSettings BrandNotificationSetting[]
  notifications        Notification[]
  integrations         BrandIntegration[]
  instagramSyncInvitations InstagramSyncInvitation[]

  @@map("brand_profiles")
}

/// Brand OAuth connections (Instagram Login + optional Meta Business Suite in Settings).
model BrandIntegration {
  id                     String                  @id @default(uuid()) @map("integration_id")
  brandProfileId         String                  @map("brand_id")
  brandProfile           BrandProfile            @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  provider               BrandIntegrationProvider
  status                 BrandIntegrationStatus  @default(DISCONNECTED)
  currentPlatformHandle  String                  @map("current_platform_handle") @db.VarChar(255)
  inboundOauthHandle     String?                 @map("inbound_oauth_handle") @db.VarChar(255)
  accessTokenEncrypted   String?                 @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted  String?                 @map("refresh_token_encrypted") @db.Text
  grantedScopes          BrandIntegrationScope[] @default([]) @map("granted_scopes")
  tokenExpiresAt         DateTime?               @map("token_expires_at")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([brandProfileId, provider], map: "uq_brand_provider_pair")
  @@index([brandProfileId, provider, status], map: "idx_brand_integrations_lookup")
  @@index([status, tokenExpiresAt], map: "idx_integrations_token_expiration")
  @@map("brand_integrations")
}

/// Temporary agent invites for onboarding Instagram sync (no permanent User).
model InstagramSyncInvitation {
  id            String                       @id @default(uuid())
  email         String
  status        InstagramSyncInvitationStatus @default(PENDING)
  token         String                       @unique
  otpCode       String?                      @map("otp_code")
  otpExpiresAt  DateTime?                    @map("otp_expires_at")
  brandProfileId String                      @map("brand_id")
  brandProfile  BrandProfile                 @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  createdAt     DateTime                     @default(now()) @map("created_at")
  expiresAt     DateTime                     @map("expires_at")

  @@index([token])
  @@index([brandProfileId])
  @@map("instagram_sync_invitations")
}

model Offering {
  id                 String       @id @default(uuid())
  brandProfileId     String       @map("brand_profile_id")
  brandProfile       BrandProfile @relation(fields: [brandProfileId], references: [id])
  type               OfferingType
  name               String
  description        String?
  imageUrl           String?      @map("image_url")
  url                String       @map("offering_url")
  /// Collection or healthcare specialty label from list pages (product Prompt 2).
  categoryTag        String?      @map("category_tag")
  /// Human-visible starting price from list view, before deep scan parses `priceAmount`.
  startingPriceLabel String?      @map("starting_price_label")
  priceAmount        Decimal?     @map("price_amount")
  currency           String       @default("USD")
  locationIds        String[]     @map("location_ids")
  isActive           Boolean      @default(true) @map("is_active")
  isDeepScanned      Boolean      @default(false) @map("is_deep_scanned")
  isUserEdited       Boolean      @default(false) @map("is_user_edited")
  sellingPoints      String[]     @default([]) @map("selling_points")
  doNotSay           String[]     @default([]) @map("do_not_say")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("offerings")
}

