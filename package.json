{
  "name": "creatorshop-be",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node scripts/copy-prompt-assets.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "pretest": "npm run prisma:generate",
    "test": "vitest run --config vitest.config.ts",
    "pretest:campaign-readiness": "npm run prisma:generate",
    "test:campaign-readiness": "vitest run --config vitest.config.ts src/features/brand-uce/services/canonical-campaign-readiness.resolver.test.ts src/features/brand-uce/services/canonical-campaign-readiness.service.test.ts src/features/brand-uce/canonical-campaign-create.controller.test.ts src/features/brand-uce/services/canonical-campaign-create.service.test.ts",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:dev-creator": "ts-node -r dotenv/config scripts/seed-dev-creator.ts",
    "db:tunnel:dev": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-tunnel.ps1",
    "db:tunnel:prod": "powershell -ExecutionPolicy Bypass -File scripts/start-prod-tunnel.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.673.0",
    "@aws-sdk/credential-providers": "^3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.772.0",
    "@google/genai": "^2.11.0",
    "@google/generative-ai": "^0.21.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.3.0",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.61.1",
    "postmark": "^4.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "yaml": "^2.8.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.16",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "sst": "^3.17.10",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.9"
  }
}
