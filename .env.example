# Copy to .env and fill in values. Never commit .env.

PORT=3000
STAGE=local
# Co-pilot turn quota: enforced only when STAGE=prod (local/dev unlimited). Override: COPILOT_QUOTA_ENFORCED=true|false
# COPILOT_QUOTA_ENFORCED=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/thecreatorshop?schema=public

# SST dev deploy only — ECS uses this when `npx sst deploy --stage dev`
DEV_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require

# Brand onboarding AI + acquisition (Stage 0 Gatekeeper + Stage 1A)
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
GATEKEEPER_GEMINI_MODEL=gemini-3.6-flash
MCP_PLANNER_GEMINI_MODEL=gemini-2.5-flash
BRAND_DNA_GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=120000

# Data Extraction provider execution. Intelligence supplies business-task model selection.
DATA_EXTRACTION_PROVIDER_MAX_ATTEMPTS=3
OPENAI_API_KEY=replace-me
GATEKEEPER_OPENAI_MODEL_ID=
# Server-authoritative legal/policy versions (required on deploy — SST passes to ECS).
# Gatekeeper admission fails if these are missing in the running container.
GATEKEEPER_TERMS_VERSION=replace-with-server-authoritative-version
GATEKEEPER_PRIVACY_POLICY_VERSION=replace-with-server-authoritative-version
# Canonical public support destination returned by GET /api/v1/discovery/support.
GATEKEEPER_SUPPORT_URL=
OPENAI_REQUEST_TIMEOUT_MS=120000

# Brand onboarding Step 6 OTP: false = stub 123456; true = Postmark (Settings auth OTP templates).
BRAND_VERIFICATION_USE_REAL_OTP=false
# Creator signup OTP toggle (same pattern as brand verification).
CREATOR_VERIFICATION_USE_REAL_OTP=false

# Acquisition stack: zyte (Stage 1A default) | parallel (legacy)
# SST deploy injects these into ECS — required for brand onboarding surface scan.
BRAND_SCAN_ACQUISITION=zyte
ZYTE_API_KEY=replace-me
ZYTE_API_URL=https://api.zyte.com/v1/extract
ZYTE_REQUEST_TIMEOUT_MS=15000
# Stage 1A runs Zyte + Playwright in parallel (merge logos/socials from PW).
# Local: default false. Deployed ECS: SST forces PLAYWRIGHT_ENABLED=true
# (Chromium installed in Docker). Opt out on ECS with PLAYWRIGHT_FORCE_OFF=true.
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_TIMEOUT_MS=25000
# PLAYWRIGHT_FORCE_OFF=true

# Parallel public-web research. Legacy surface acquisition remains disabled; the
# Data Extraction Gatekeeper capability uses the same credential/client directly.
PARALLEL_API_KEY=replace-me
PARALLEL_EXTRACT_TIMEOUT_MS=300000
PARALLEL_SEARCH_TIMEOUT_MS=60000
PARALLEL_SEARCH_MAX_CHARS_TOTAL=24000

# Creator onboarding — Instagram Graph OAuth (backend only)
INSTAGRAM_API_ID=replace-me
INSTAGRAM_APP_SECRET=replace-me
# Optional override (default v26.0)
# INSTAGRAM_GRAPH_VERSION=v26.0

# Public HTTPS API origin for Meta data-deletion status URLs (required in deployed env)
PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: Google signup during creator onboarding
GOOGLE_CLIENT_ID=

# Encrypts OAuth tokens and sensitive settings fields at rest (32-byte base64)
SETTINGS_FIELD_ENCRYPTION_KEY=replace-me

# Authentication challenges always use Postmark; there is no fixed-code mode.

# QA: comma-separated creator emails that bypass campaign targeting for
# marketplace ELIGIBLE_ONLY visibility + apply (not INVITED_ONLY).
# Seed: npm run db:seed:dev-creator → test@creator.com
# Leave empty in production unless you intentionally enable QA bypass.
CREATOR_APPLY_BYPASS_EMAILS=test@creator.com

# Brand onboarding scan limits: true|false. When unset, local STAGE skips limits; dev/prod enable them.
# Local default: leave unset or set false so you can scan freely during UI work.
BRAND_SCAN_LIMITS_ENABLED=false
BRAND_SCAN_FORCE_REFRESH=false

POSTMARK_SERVER_TOKEN=replace-me
POSTMARK_OTP_TEMPLATE_ID=replace-me
POSTMARK_AUTH_OTP_TEMPLATE_ID=replace-me
POSTMARK_PASSWORD_RESET_TEMPLATE_ID=replace-me
POSTMARK_TEAM_INVITE_TEMPLATE_ID=replace-me
POSTMARK_AUTH_FROM=no-reply@thecreatorshop.in
POSTMARK_AUTH_MESSAGE_STREAM=outbound
POSTMARK_NOTIFICATION_FROM=no-reply@thecreatorshop.in
POSTMARK_NOTIFICATION_DEFAULT_TEMPLATE_ID=replace-me

# Local-only frontend URL (SST dev/prod use APP_FRONTEND_URL_DEV / _PROD or defaults)
APP_FRONTEND_URL=http://localhost:5173
# APP_FRONTEND_URL_DEV=https://dashboard.dev.thecreatorshop.in
# APP_FRONTEND_URL_PROD=https://dashboard.thecreatorshop.in

# Optional: comma-separated extra CORS origins (e.g. ngrok URL without trailing slash)
# CORS_ORIGINS=https://your-id.ngrok-free.app

NOTIFICATIONS_DEV_EMIT_ENABLED=false

# Local `npm run start:prod` uses plain JWT_SECRET / AUTH_OTP_PEPPER.
# SST deploy maps JWT_SECRET_DEV|PROD and AUTH_OTP_PEPPER_DEV|PROD into ECS.
JWT_SECRET=replace-me
JWT_SECRET_DEV=replace-me
JWT_SECRET_PROD=replace-me
JWT_ISSUER=creatorshop-api-local
JWT_AUDIENCE=creatorshop-dashboard
JWT_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_OTP_TTL=10m
AUTH_RESET_TTL=30m
AUTH_OTP_PEPPER=replace-me
AUTH_OTP_PEPPER_DEV=replace-me
AUTH_OTP_PEPPER_PROD=replace-me

# Local S3 mirror only — deployed stages use SST bucket name
S3_BUCKET_NAME=creatorshop-v2-files-local
AWS_REGION=ap-south-1

RAZORPAY_API_KEY_ID=replace-me
RAZORPAY_API_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
# Route runtime remains disabled until account entitlement and Test fixtures are verified.
RAZORPAY_ROUTE_WEBHOOK_SECRET=
RAZORPAY_ROUTE_WEBHOOK_EVENT_MAP={}
RAZORPAY_BRAND_RETURN_WEBHOOK_SECRET=
RAZORPAY_BRAND_RETURN_WEBHOOK_EVENT_MAP={}

EXTERNAL_API_TIMEOUT_MS=10000

# Per-event Postmark template IDs (unset → POSTMARK_NOTIFICATION_DEFAULT_TEMPLATE_ID)
# POSTMARK_TEMPLATE_INTEGRATION_META_TOKEN_EXPIRED=
# POSTMARK_TEMPLATE_TEAM_INVITE_PENDING=
# POSTMARK_TEMPLATE_ESCROW_LOW_BALANCE=
# POSTMARK_TEMPLATE_BILLING_INVOICE_PAYMENT_FAILED=
# POSTMARK_TEMPLATE_BILLING_TAX_INVOICE_COMPILED=
# POSTMARK_TEMPLATE_PRICING_TRIAL_EXPIRING=
# POSTMARK_TEMPLATE_PRICING_SUBSCRIPTION_RENEWED=
# POSTMARK_TEMPLATE_PRICING_USAGE_CAP_APPROACHING=
# POSTMARK_TEMPLATE_PLANNER_COMPETITIVE_SCAN_COMPLETE=
# POSTMARK_TEMPLATE_OUTREACH_MILESTONE_COUNTER_OFFER=
# POSTMARK_TEMPLATE_WORKFLOW_ASSET_DRAFT_SUBMITTED=
# POSTMARK_TEMPLATE_WORKFLOW_MILESTONE_OVERDUE_CREATOR=
# POSTMARK_TEMPLATE_WORKFLOW_BRAND_REVIEW_OVERDUE=
# POSTMARK_TEMPLATE_WORKFLOW_COMPLIANCE_FAILURE=
