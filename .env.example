# Copy to .env and fill in values. Never commit .env.

PORT=3000
STAGE=local
DATABASE_URL=postgresql://postgres:password@localhost:5432/thecreatorshop?schema=public

# SST dev deploy only — ECS uses this when `npx sst deploy --stage dev`
DEV_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require

# Brand onboarding AI + acquisition (Stage 0 Gatekeeper + Stage 1A)
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
GATEKEEPER_GEMINI_MODEL=gemini-2.5-flash
MCP_PLANNER_GEMINI_MODEL=gemini-2.5-flash
BRAND_DNA_GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=120000

# Acquisition stack: zyte (default) | parallel (legacy — re-enable code comments)
BRAND_SCAN_ACQUISITION=zyte
ZYTE_API_KEY=replace-me
ZYTE_API_URL=https://api.zyte.com/v1/extract
ZYTE_REQUEST_TIMEOUT_MS=15000
# Playwright is currently disabled in code (see core-identity-orchestrator.service.ts,
# pending product decision). Stage 1A uses Zyte httpResponseBody first, then
# Zyte browserHtml (JS-rendered, pricier) as fallback. These vars only matter
# if the Playwright block is re-enabled.
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_TIMEOUT_MS=15000

# Legacy Parallel surface scan (disabled — keep keys only if reactivating parallel path)
# PARALLEL_API_KEY=replace-me
# PARALLEL_EXTRACT_TIMEOUT_MS=300000
# PARALLEL_SEARCH_TIMEOUT_MS=60000
# PARALLEL_SEARCH_MAX_CHARS_TOTAL=24000

# Creator onboarding — Instagram Graph OAuth (backend only)
INSTAGRAM_API_ID=replace-me
INSTAGRAM_APP_SECRET=replace-me

# Optional: Google signup during creator onboarding
GOOGLE_CLIENT_ID=

# Encrypts OAuth tokens and sensitive settings fields at rest (32-byte base64)
SETTINGS_FIELD_ENCRYPTION_KEY=replace-me

# OTP: false = stub 123456 locally; true = Postmark (requires POSTMARK_* below)
CREATOR_VERIFICATION_USE_REAL_OTP=false
BRAND_VERIFICATION_USE_REAL_OTP=false

# Brand onboarding scan limits: true|false. When unset, local STAGE skips limits; dev/prod enable them.
# Local default: leave unset or set false so you can scan freely during UI work.
BRAND_SCAN_LIMITS_ENABLED=false
BRAND_SCAN_FORCE_REFRESH=false

POSTMARK_SERVER_TOKEN=replace-me
POSTMARK_OTP_TEMPLATE_ID=replace-me
POSTMARK_NOTIFICATION_FROM=no-reply@thecreatorshop.in
POSTMARK_NOTIFICATION_DEFAULT_TEMPLATE_ID=replace-me

# Local-only frontend URL (SST dev/prod use APP_FRONTEND_URL_DEV / _PROD or defaults)
APP_FRONTEND_URL=http://localhost:5173
# APP_FRONTEND_URL_DEV=https://dashboard.dev.thecreatorshop.in
# APP_FRONTEND_URL_PROD=https://dashboard.thecreatorshop.in

# Optional: comma-separated extra CORS origins (e.g. ngrok URL without trailing slash)
# CORS_ORIGINS=https://your-id.ngrok-free.app

NOTIFICATIONS_DEV_EMIT_ENABLED=false

JWT_SECRET_DEV=replace-me
JWT_SECRET_PROD=replace-me

# Local S3 mirror only — deployed stages use SST bucket name
S3_BUCKET_NAME=creatorshop-v2-files-local
AWS_REGION=ap-south-1

RAZORPAY_API_KEY_ID=replace-me
RAZORPAY_API_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

EXTERNAL_API_TIMEOUT_MS=10000

# Per-event Postmark template IDs (unset → POSTMARK_NOTIFICATION_DEFAULT_TEMPLATE_ID)
# POSTMARK_TEMPLATE_INTEGRATION_META_TOKEN_EXPIRED=
# POSTMARK_TEMPLATE_TEAM_INVITE_PENDING=
# POSTMARK_TEMPLATE_ESCROW_LOW_BALANCE=
# POSTMARK_TEMPLATE_BILLING_INVOICE_PAYMENT_FAILED=
# POSTMARK_TEMPLATE_BILLING_TAX_INVOICE_COMPILED=
# POSTMARK_TEMPLATE_PRICING_TRIAL_EXPIRING=
# POSTMARK_TEMPLATE_PRICING_SUBSCRIPTION_RENEWED=
# POSTMARK_TEMPLATE_PRICING_USAGE_CAP_APPROACHING=
# POSTMARK_TEMPLATE_PLANNER_COMPETITIVE_SCAN_COMPLETE=
# POSTMARK_TEMPLATE_OUTREACH_MILESTONE_COUNTER_OFFER=
# POSTMARK_TEMPLATE_WORKFLOW_ASSET_DRAFT_SUBMITTED=
# POSTMARK_TEMPLATE_WORKFLOW_MILESTONE_OVERDUE_CREATOR=
# POSTMARK_TEMPLATE_WORKFLOW_BRAND_REVIEW_OVERDUE=
# POSTMARK_TEMPLATE_WORKFLOW_COMPLIANCE_FAILURE=
