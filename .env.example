PORT=3000
STAGE=local
DATABASE_URL=postgresql://postgres:password@localhost:5432/thecreatorshop_v2?schema=public

# Optional SST dev deploy: RDS override (prod uses SST Aurora)
DEV_DATABASE_URL=

# Auth (local uses JWT_SECRET_DEV via STAGE=local; deploy sets JWT_SECRET from *_DEV / *_PROD)
JWT_SECRET_DEV=
JWT_SECRET_PROD=

# Brand verification email (required on deploy)
POSTMARK_SERVER_TOKEN=
POSTMARK_OTP_TEMPLATE_ID=
# Deployed default true; local stub OTP unless set:
# BRAND_VERIFICATION_USE_REAL_OTP=false

# Surface scan vendors (required for live scans)
PARALLEL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REQUEST_TIMEOUT_MS=120000
# PARALLEL_EXTRACT_TIMEOUT_MS=120000
# PARALLEL_SEARCH_TIMEOUT_MS=90000
# PARALLEL_SEARCH_MAX_CHARS_TOTAL=24000
# PARALLEL_COMPETITOR_SEARCH_ENABLED=true

# S3 (local optional; deploy sets from SST files-v2 bucket)
# S3_BUCKET_NAME=creatorshop-v2-files-local
# AWS_REGION=ap-south-1

# CORS
# CORS_ORIGINS=http://localhost:5173,https://dashboard.dev.thecreatorshop.in

# Scan limits (deploy default true when STAGE is dev/prod)
# BRAND_SCAN_LIMITS_ENABLED=true
# BRAND_SCAN_FORCE_REFRESH=false
# DEFAULT_CURRENCY_CODE=USD
